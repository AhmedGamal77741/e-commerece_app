
# Prevent caching of index.html and service worker so users ALWAYS get the latest version immediately
<FilesMatch "\.(html|json)$|flutter_service_worker\.js$|flutter_bootstrap\.js$">
    FileETag None
    Header unset ETag
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
</FilesMatch>

# Cache all other assets (WASM, JS, Fonts, Images) for a year since Flutter automatically hashes their filenames on new builds
<FilesMatch "\.(js|wasm|png|jpg|jpeg|gif|ico|ttf|woff|woff2|css)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
</FilesMatch>

# SPA Fallback & Open Graph Generator for Product links
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Route /product/* to product_preview.php for dynamic Open Graph tags
    RewriteRule ^product/([a-zA-Z0-9_-]+)$ product_preview.php?productId=$1 [QSA,L]
    
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>

